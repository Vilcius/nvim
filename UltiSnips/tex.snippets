% \setlength{\parindent}{0pt}
% \renewcommand{\labelenumi}{(\alph{enumi})}
\newcommand{\labelitemi}{\setbeamercolor{math text}{fg = rpPink}$\blacktriangleright$}
\newcommand{\labelitemii}{\setbeamercolor{math text}{fg = rpLightBlue}$\blacktriangleright$}

%--------------------------------------------------------------------------
%Header
\usetheme{Warsaw}
\setbeamercolor{structure}{fg=rpBlue}
\setbeamercolor{math text}{fg=rpLightBlue}
\setbeamercolor{section in head/foot}{fg=rpPink,bg=rpDarkPurple}
\setbeamercolor{page number in head/foot}{fg=rpYellow}
\setbeamercolor{title in head/foot}{fg=black}
\setbeamercolor{title}{fg=black}
\setbeamercolor{frametitle}{fg=black}
\setbeamercolor{block title}{fg=black}
% \setbeamercolor{itemize subitem}{bg=color3}
\setbeamercolor{normal text}{fg=rpWhite, bg = rpLightPurple}
% \setbeamercolor{normal text}{fg = background, bg=color7}
\newcommand*\oldmacro{}%
\let\oldmacro\insertshorttitle%
\renewcommand*\insertshorttitle{%
  \oldmacro\hfill%
\insertframenumber\,/\,\inserttotalframenumber}
\setbeamercovered{transparent}

\newcommand{\myname}{\textit{Anthony Wilkie}}
\newcommand{\course}{}
\newcommand{\topic}{${1: topic}}

%-------------------------------------------------------------------------------
% Local Commands
\renewcommand{\textit}[1]{\tc{rpYellow}{\emph{#1}}}

%--------------------------------------------------------------------------
%Title
\title[${2: short title}]{\topic}
\author[Anthony Wilkie]{\myname}
\institute{University of Tennessee}
\date{${3: today}}

%##########################################################################
%Document
\begin{document}

%-------------------------------------------------------------------------------
% Frame Title
\begin{frame}
  \maketitle
\end{frame}

$0

\end{document}
endsnippet


