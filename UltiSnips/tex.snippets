context "math()"
snippet csq "Commutative Square" bA
\begin{tikzcd}
	$1 \arrow[r, "$2"] \arrow[d, "$4"] 
	& $3 \arrow[d, "$5"] \\\\
	$6 \arrow[r, "$7"] 
	& $8
\end{tikzcd}$0
endsnippet

context "math()"
snippet ctr "Commutative Triangle" bA
\begin{tikzcd}
	$1 \arrow[rr, "$2"] \arrow[rd, "$4"'] 
	& & $3 \arrow[ld, "$5"] \\\\
	& $6 &
\end{tikzcd}$0
endsnippet

