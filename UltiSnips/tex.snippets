snippet template "Basic template" bA
%##########################################################################
\documentclass[12pt]{article}

%-------------------------------------------------------------------------------
%Preamble
%Either change the file path below to where you save
%Preamble.tex or copy and paste contents of Preamble.tex
%here and comment out line below
\IfFileExists{./Preamble.tex}{%
\input{Preamble.tex}
}{%
\input{/home/vilcius/Programming/LaTeX/Preamble.tex}
}
\usepackage{setspace}
%\onehalfspacing
\usepackage[margin=.5in]{geometry}

\setlength{\columnsep}{0pt}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{2}
\setlength{\parindent}{0pt}
\renewcommand{\labelenumi}{(\alph{enumi})}

%-------------------------------------------------------------------------------
%Header
\setlength{\headheight}{12pt}

\newcommand{\myname}{Anthony Wilkie}
\newcommand{\course}{$1}
\newcommand{\topic}{$2}
\newcommand{\secnum}{Section 5.1}

%\pagestyle{empty}
%\fancyhf{}
\rhead{\course}
\chead{\topic}
\lhead{\secnum}
%\rfoot{Page \thepage}

%-------------------------------------------------------------------------------
%Title
\title{\vspace{-.75in}\secnum: \topic\vspace{-.5in}}
%\author{\topic}
\date{}

%##########################################################################
%Document
\begin{document}
	$0
\end{document}
%##########################################################################
endsnippet

